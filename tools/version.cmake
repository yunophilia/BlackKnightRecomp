# Writes VERSION_OUT, the build's version string: BKR_VERSION from the environment (the
# release workflow sets it to the tag), else `git describe`, else "dev". Runs on every
# build but only rewrites the file when the version changed.
if(NOT "$ENV{BKR_VERSION}" STREQUAL "")
    set(version "$ENV{BKR_VERSION}")
else()
    execute_process(COMMAND git describe --tags --always --dirty
                    WORKING_DIRECTORY "${SOURCE_DIR}"
                    OUTPUT_VARIABLE version OUTPUT_STRIP_TRAILING_WHITESPACE
                    RESULT_VARIABLE result ERROR_QUIET)
    if(NOT result EQUAL 0 OR "${version}" STREQUAL "")
        set(version "dev")
    endif()
endif()

set(text "// generated by tools/version.cmake\n#include \"version.h\"\nconst char g_version[] = \"${version}\";\n")
set(old "")
if(EXISTS "${VERSION_OUT}")
    file(READ "${VERSION_OUT}" old)
endif()
if(NOT "${old}" STREQUAL "${text}")
    file(WRITE "${VERSION_OUT}" "${text}")
endif()
