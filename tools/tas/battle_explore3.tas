players 2
# Boot to the menus with a save loaded, taking a screenshot after each step.
include watches.tas
log boot
wait 40
hold 0.3 A+B
wait 5.7
hold 0.3 A+B
wait 5.7
hold 0.3 A
wait 7.7
shot m01_title
hold 0.3 START
wait 3.7
shot m02
hold 0.3 START
wait 3.7
shot m03
tap DOWN 0.12
wait 1
tap A 0.15
wait 3
shot bt_01
tap A 0.15
wait 3
shot bt_02
tap A 0.15
wait 3
tap P2:A 0.15
wait 2
shot bv_01
tap P2:A 0.15
wait 2
shot bv_02
tap A P2:A 0.15
wait 3
shot bv_03
tap A 0.15
wait 3
shot bv_04
tap A 0.15
wait 4
shot bv_05
wait 4
shot bv_06
quit
