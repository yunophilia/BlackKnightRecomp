include watches.tas
watch px f32 [8072bfbc]+380
watch py f32 [8072bfbc]+384
watch pz f32 [8072bfbc]+388
log boot
wait 2
# skip the strap screen, Sega logo and intro until the title screen loads
until file adv_title_eng mash A+B timeout 80
wait 2
hold 0.3 A+B
wait 5.7
hold 0.3 A
wait 7.7
hold 0.3 A
wait 3
hold 1 PX=0.745+PY=0.538
filemark
tap A+PX=0.745+PY=0.538 0.1
wait 2.5
wait 0.3
shot crystal_goal_select
tap A 0.2
wait 1.5
tap A 0.2
until file files_stg timeout 40
wait 8
log play
mash A 4
wait 1
tap HOME 0.3
wait 2.5
shot h1_home
hold 1.5 PX=0.5+PY=0.5
shot h2_pointer_center
wait 0.5
quit
