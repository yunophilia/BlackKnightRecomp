players 2
# Boot to the menus with a save loaded, taking a screenshot after each step.
include watches.tas
log boot
wait 40
hold 0.3 A+B
wait 5.7
hold 0.3 A+B
wait 5.7
hold 0.3 A
wait 7.7
shot m01_title
hold 0.3 START
wait 3.7
shot m02
hold 0.3 START
wait 3.7
shot m03
tap DOWN 0.12
wait 1
tap A 0.15
wait 3
shot bt_01
tap A 0.15
wait 3
shot bt_02
tap A 0.15
wait 3
tap P2:A 0.15
wait 2
shot bv_01
tap P2:A 0.15
wait 2
shot bv_02
mash P2:A 3 0.4
shot bw_01
tap P2:LY=-1.0 0.2
wait 0.5
mash P2:A 2 0.4
shot bw_02
tap P2:START 0.2
wait 1
shot bw_03
tap A 0.15
wait 2
shot bw_04
tap START 0.15
wait 4
shot bw_05
wait 5
shot bw_06
quit
