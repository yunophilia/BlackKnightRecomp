include ../watches.tas
watch px f32 [80803e10]+2050
watch py f32 [80803e10]+2054
watch pz f32 [80803e10]+2058
log boot
wait 40
hold 0.3 A+B
wait 5.7
hold 0.3 A+B
wait 5.7
hold 0.3 A
wait 7.7
hold 0.3 START
wait 3.7
hold 0.3 START
wait 3.7
hold 0.3 A
wait 3
hold 1 PX=0.544+PY=0.671
hold 0.3 A+PX=0.544+PY=0.671
wait 2.5
wait 0.3
shot boss_arthur_select
tap A 0.2
wait 1.5
tap A 0.2
until file files_stg timeout 40
wait 8
log play
calls -
shot boss_arthur_start
repeat 40
set LY=0.5
tap X 0.1
wait 0.3
hold 0.3 RB
set LX=-0.7
tap A 0.15
wait 0.3
hold 0.2 RX=1.0
tap X+A 0.1
wait 0.4
end
set
calls boss_arthur
shot boss_arthur_end
wait 0.5
log end
quit
