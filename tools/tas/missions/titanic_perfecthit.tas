include ../watches.tas
watch px f32 [8072bfbc]+380
watch py f32 [8072bfbc]+384
watch pz f32 [8072bfbc]+388
log boot
wait 40
hold 0.3 A+B
wait 5.7
hold 0.3 A+B
wait 5.7
hold 0.3 A
wait 7.7
hold 0.3 START
wait 3.7
hold 0.3 START
wait 3.7
hold 0.3 A
wait 3
hold 1 PX=0.559+PY=0.213
filemark
tap A+PX=0.559+PY=0.213 0.1
wait 2.5
wait 0.3
shot titanic_perfecthit_select
tap A 0.2
wait 1.5
tap A 0.2
until file files_stg timeout 40
wait 8
log play
calls -
shot titanic_perfecthit_start
repeat 40
set LY=0.6
tap X 0.1
wait 0.3
tap X 0.1
wait 0.3
set LX=0.6
tap A 0.15
wait 0.5
tap X 0.1
wait 0.4
end
set
calls titanic_perfecthit
shot titanic_perfecthit_end
wait 0.5
log end
quit
