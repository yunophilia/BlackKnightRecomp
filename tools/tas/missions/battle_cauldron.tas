players 2
include ../watches.tas
watch px f32 [PlayerPtr]+380
watch py f32 [PlayerPtr]+384
watch pz f32 [PlayerPtr]+388
log boot
wait 2
# skip the strap screen, Sega logo and intro until the title screen loads
until file adv_title_eng mash A+B timeout 80
wait 2
hold 0.3 A+B
wait 5.7
hold 0.3 A
wait 7.7
tap DOWN 0.12
wait 1
tap A 0.15
wait 3
tap A 0.15
wait 3
tap A 0.15
wait 2
tap P2:A 0.15
wait 2
tap P2:A 0.15
wait 2
hold 1 P2:PX=0.40+PY=0.26
tap P2:A+PX=0.40+PY=0.26 0.15
wait 1.5
tap P2:A 0.15
wait 1.5
tap A 0.15
wait 2
tap START 0.15
wait 2
tap A 0.15
wait 3
filemark
hold 1 PX=0.45+PY=0.56
tap A+PX=0.45+PY=0.56 0.15
wait 1.5
shot battle_cauldron_select
tap A 0.15
until file sng_stg timeout 40
wait 6
log play
calls -
shot battle_cauldron_start
set LY=1.0 P2:LY=1.0
repeat 40
tap X P2:X 0.1
wait 0.3
set LX=0.7 P2:LX=-0.7
tap A P2:A 0.15
wait 0.5
set LY=1.0 P2:LY=1.0
tap X P2:X 0.1
wait 0.6
end
set
calls battle_cauldron
shot battle_cauldron_end
wait 0.5
log end
quit
