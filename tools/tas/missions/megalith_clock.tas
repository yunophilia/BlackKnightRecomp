include ../watches.tas
watch px f32 [PlayerPtr]+380
watch py f32 [PlayerPtr]+384
watch pz f32 [PlayerPtr]+388
log boot
wait 2
# skip the strap screen, Sega logo and intro until the title screen loads
until file adv_title_eng mash A+B timeout 80
wait 2
hold 0.3 A+B
wait 5.7
hold 0.3 A
wait 7.7
hold 0.3 A
wait 3
hold 1 PX=0.664+PY=0.167
filemark
tap A+PX=0.664+PY=0.167 0.1
wait 2.5
wait 0.3
shot megalith_clock_select
tap A 0.2
wait 1.5
tap A 0.2
until file files_stg timeout 40
wait 8
log play
calls -
shot megalith_clock_start
set LY=1.0
repeat 40
tap X 0.1
wait 0.4
tap A 0.15
wait 0.6
tap X 0.1
wait 0.5
end
set
calls megalith_clock
shot megalith_clock_end
wait 0.5
log end
quit
