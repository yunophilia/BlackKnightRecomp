wait 2
log loc misty
hold 0.8 PX=0.177+PY=0.483
shot loc_misty
hold 0.3 A+PX=0.177+PY=0.483
wait 2.5
shot ms_misty
tap B 0.2
wait 2
log loc crystal
hold 0.8 PX=0.745+PY=0.538
shot loc_crystal
hold 0.3 A+PX=0.745+PY=0.538
wait 2.5
shot ms_crystal
