# Boot to the menus with a save loaded, taking a screenshot after each step.
include watches.tas
log boot
wait 40
hold 0.3 A+B
wait 5.7
hold 0.3 A+B
wait 5.7
hold 0.3 A
wait 7.7
shot m01_title
hold 0.3 START
wait 3.7
shot m02
hold 0.3 START
wait 3.7
shot m03
hold 0.3 A
wait 3
shot m04
wait 0.5
log loc shrouded
hold 0.8 PX=0.331+PY=0.217
shot loc_shrouded
hold 0.3 A+PX=0.331+PY=0.217
wait 2.5
shot ms_shrouded
tap B 0.2
wait 2
log loc titanic
hold 0.8 PX=0.559+PY=0.213
shot loc_titanic
hold 0.3 A+PX=0.559+PY=0.213
wait 2.5
shot ms_titanic
tap B 0.2
wait 2
log loc megalith
hold 0.8 PX=0.664+PY=0.167
shot loc_megalith
hold 0.3 A+PX=0.664+PY=0.167
wait 2.5
shot ms_megalith
tap B 0.2
wait 2
log loc deepwoods
hold 0.8 PX=0.220+PY=0.358
shot loc_deepwoods
hold 0.3 A+PX=0.220+PY=0.358
wait 2.5
shot ms_deepwoods
tap B 0.2
wait 2
