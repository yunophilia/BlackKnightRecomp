# Boot to the menus with a save loaded, taking a screenshot after each step.
include watches.tas
log boot
wait 40
hold 0.3 A+B
wait 5.7
hold 0.3 A+B
wait 5.7
hold 0.3 A
wait 7.7
shot m01_title
hold 0.3 START
wait 3.7
shot m02
hold 0.3 START
wait 3.7
shot m03
hold 0.3 A
wait 3
shot m04
wait 0.5
hold 1 PX=0.177+PY=0.483
dump L_misty1
hold 1 PX=0.745+PY=0.538
dump L_crystal
hold 1 PX=0.453+PY=0.396
dump L_camelot
hold 1 PX=0.177+PY=0.483
dump L_misty2
hold 1 PX=0.745+PY=0.538
tap A 0.3
wait 2.5
dump M_0
tap DOWN 0.15
wait 1
dump M_1
tap DOWN 0.15
wait 1
dump M_2
tap UP 0.15
wait 1
dump M_3
shot M_3
quit
