include watches.tas
watch px f32 [PlayerObjPtr]+2050
watch py f32 [PlayerObjPtr]+2054
watch pz f32 [PlayerObjPtr]+2058
log boot
wait 40
hold 0.3 A+B
wait 5.7
hold 0.3 A+B
wait 5.7
hold 0.3 A
wait 7.7
hold 0.3 START
wait 3.7
hold 0.3 START
wait 3.7
hold 0.3 A
wait 3
hold 1 PX=0.220+PY=0.358
filemark
tap A+PX=0.220+PY=0.358 0.1
wait 2.5
tap UP 0.12
wait 0.55
tap LEFT 0.12
wait 0.55
tap DOWN 0.12
wait 0.55
wait 0.3
shot boss_lancelot_select
tap A 0.2
wait 1.5
tap A 0.2
until file files_stg timeout 40
wait 8
log play
wait 4
dump boss_lancelot_s0
wait 0.5
dump boss_lancelot_s0b
hold 1.2 LY=1.0
wait 1.2
dump boss_lancelot_s1
wait 0.5
dump boss_lancelot_s1b
hold 1.2 LX=1.0
wait 1.2
dump boss_lancelot_s2
hold 0.4 A
wait 0.15
dump boss_lancelot_s3air
wait 2
dump boss_lancelot_s4
quit
