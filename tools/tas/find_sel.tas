# Boot to the menus with a save loaded, taking a screenshot after each step.
include watches.tas
log boot
wait 40
hold 0.3 A+B
wait 5.7
hold 0.3 A+B
wait 5.7
hold 0.3 A
wait 7.7
shot m01_title
hold 0.3 START
wait 3.7
shot m02
hold 0.3 START
wait 3.7
shot m03
hold 0.3 A
wait 3
shot m04
wait 1
dump sel_a
tap RIGHT 0.15
wait 1.5
shot sel_b
dump sel_b
tap LEFT 0.15
wait 1.5
shot sel_c
dump sel_c
tap UP 0.15
wait 1.5
shot sel_d
dump sel_d
tap UP 0.15
wait 1.5
shot sel_e
dump sel_e
wait 0.5
quit
