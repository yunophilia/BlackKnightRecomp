# Boot to the menus with a save loaded, taking a screenshot after each step.
include watches.tas
log boot
wait 40
hold 0.3 A+B
wait 5.7
hold 0.3 A+B
wait 5.7
hold 0.3 A
wait 7.7
shot m01_title
hold 0.3 START
wait 3.7
shot m02
hold 0.3 START
wait 3.7
shot m03
hold 0.3 A
wait 3
shot m04
wait 0.5
hold 1 PX=0.745+PY=0.538
tap A 0.3
wait 2.5
shot cyc_00
tap DOWN 0.15
wait 0.8
shot cyc_01
tap DOWN 0.15
wait 0.8
shot cyc_02
tap DOWN 0.15
wait 0.8
shot cyc_03
tap DOWN 0.15
wait 0.8
shot cyc_04
tap DOWN 0.15
wait 0.8
shot cyc_05
tap DOWN 0.15
wait 0.8
shot cyc_06
tap DOWN 0.15
wait 0.8
shot cyc_07
tap DOWN 0.15
wait 0.8
shot cyc_08
tap DOWN 0.15
wait 0.8
shot cyc_09
tap DOWN 0.15
wait 0.8
shot cyc_10
wait 0.5
quit
