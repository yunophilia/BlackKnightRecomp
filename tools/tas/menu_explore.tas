# Boot to the menus with a save loaded, taking a screenshot after each step.
include watches.tas
log boot
wait 40
hold 0.3 A+B
wait 5.7
hold 0.3 A+B
wait 5.7
hold 0.3 A
wait 7.7
shot m01_title
hold 0.3 START
wait 3.7
shot m02
hold 0.3 START
wait 3.7
shot m03
hold 0.3 A
wait 3
shot m04
hold 0.3 A
wait 3
shot m05
hold 0.3 A
wait 3
shot m06
hold 0.3 A
wait 3
shot m07
hold 0.3 A
wait 4
shot m08
wait 4
shot m09
quit
